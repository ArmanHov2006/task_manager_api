{
  "manifest_version": 3,
  "name": "Phantom - Ambient Productivity AI",
  "version": "1.0.0",
  "description": "AI that detects your cognitive mode and orchestrates your work environment",
  "permissions": ["tabs", "storage", "idle", "webNavigation", "alarms"],
  "host_permissions": ["http://localhost:8000/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}


